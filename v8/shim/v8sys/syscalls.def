V8SYS(ioctl,	v8s_ioctl,	int,	long,	1)
V8SYS(alarm,	v8s_alarm,	unsigned,	long,	1)
V8SYS(time,	v8s_time,	long,	long,	1)
V8SYS(ftime,	v8s_ftime,	int,	long,	1)
V8SYS(times,	v8s_times,	long,	long,	1)
V8SYS(stime,	v8s_stime,	int,	long,	1)
V8SYS(chroot,	v8s_chroot,	int,	long,	1)
V8SYS(nap,	v8s_nap,	int,	long,	1)
V8SYS(sbrk,	v8s_sbrk,	char *,	char *,	1)
V8SYS(brk,	v8s_brk,	int,	long,	1)
V8SYS(mount,	v8s_mount,	int,	long,	1)
V8SYS(umount,	v8s_umount,	int,	long,	1)
V8SYS(gmount,	v8s_gmount,	int,	long,	1)
V8SYS(swapon,	v8s_swapon,	int,	long,	1)
V8SYS(reboot,	v8s_reboot,	int,	long,	1)
V8SYS(acct,	v8s_acct,	int,	long,	1)
